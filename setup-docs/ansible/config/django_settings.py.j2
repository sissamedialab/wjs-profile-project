CACHES = {
    # This instance owns DB {{ redis_db }} outright: `cache.clear()` FLUSHDBs it, and that is fine
    # as long as nothing else lives here. Do not point the queue or the sessions at it.
    "default": {
        "BACKEND": "django_redis.cache.RedisCache",
        "LOCATION": "redis://127.0.0.1:6379/{{ redis_db }}",
        "OPTIONS": {
            "CLIENT_CLASS": "django_redis.client.DefaultClient",
        }
    },
    # Sessions must survive a `cache.clear()`, hence a separate DB. It is shared with the other
    # instances, so KEY_PREFIX is what keeps them apart.
    "session": {
        "BACKEND": "django_redis.cache.RedisCache",
        "LOCATION": "redis://127.0.0.1:6379/11",
        "KEY_PREFIX": "{{ full_name }}",
        "OPTIONS": {
            "CLIENT_CLASS": "django_redis.client.DefaultClient",
        }
    },
}


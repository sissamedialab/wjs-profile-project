DEBUG=True

# Redis DB layout on this machine (see also CACHES below).
# Beware: `cache.clear()` (django_redis) issues a raw FLUSHDB, so anything sharing a DB with
# the "default" cache is destroyed along with it. Keep the three concerns on separate DBs:
# - {{ redis_db }} - this instance's cache; the ONLY DB that ever gets flushed
# - 10  - task queues of *all* instances; sharing is safe because django-q namespaces the queue
#         key by Q_CLUSTER["name"] -> "django_q:{{ full_name }}:q"
# - 11  - sessions of *all* instances; sharing is safe thanks to the per-instance KEY_PREFIX
# - 0   - channels of *all* instances; sharing is safe thanks to the per-instance prefix
#         (see CHANNEL_LAYERS below)
Q_CLUSTER = {
    "name": "{{ full_name }}",
    "label": "Task WJS {{ full_name }}",
    "workers": 1,
    "sync": False,
    "redis": "redis://localhost:6379/10",
    "retry": 330,
    "timeout": 300,
}

# Override the inherited CHANNEL_LAYERS only to set a per-instance prefix: all instances share
# Redis DB 0 here, and the group names we use (e.g. "group_{feedback_ws_name}", see
# wjs/channels/consumers.py) are not unique across instances, so without this a WebSocket message
# sent by one instance would be delivered to clients connected to another.
# The trailing ":" keeps one instance's keys from being a prefix of another's (t1 vs t10), which
# matters for the wildcard delete in RedisChannelLayer.flush().
CHANNEL_LAYERS = {
    "default": {
        "BACKEND": "channels_redis.core.RedisChannelLayer",
        "CONFIG": {
            "hosts": [("127.0.0.1", 6379)],
            "prefix": "asgi-{{ full_name }}:",
        },
    },
}

